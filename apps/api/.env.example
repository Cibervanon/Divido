# Variables del servidor API
PORT=4000
HOST=0.0.0.0
# Cambiar en producción
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Base de datos Postgres (obligatoria)
DATABASE_URL=
# Origen de la app web (para enlaces de invitación y CORS)
WEB_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# OAuth de Google (opcional: sin esto, el botón de Google no funcionará)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Envío de emails de verificación y restablecimiento de contraseña (Resend)
RESEND_API_KEY=
# Remitente de los emails (por defecto onboarding@resend.dev, solo envía a tu propio email)
EMAIL_FROM=onboarding@resend.dev
